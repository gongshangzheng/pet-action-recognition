# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Data & Cache (generated / runtime)
papers/data/
papers/cache/
*.db
*.db-shm
*.db-wal

# Temp logs
/tmp/*.log

# Evaluation results
evaluation/results/

# results/ is entirely runtime-generated (training/eval outputs), not tracked
results/

# All checkpoints (trained + pretrained), large, not committed
/checkpoints/

# datasets/ entirely: runtime/external data (videos on NAS, list files generated), not committed
/datasets/

# Dataset thumbnails cache (generated from video middle frames)
/datasets/.thumbs/

# Dataset artifacts (large video files; lists/README may be committed)
datasets/quadruped_action/videos_*/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment
.env
.env.local

# Node / Web
web/node_modules/
web/dist/
web/package-lock.json

# Python virtual env (server)
server/__pycache__/
server/**/__pycache__/
server/.venv/
*.egg-info/
.playwright-mcp/
third-party/
*.zip
